{
   "action": {
      "default_icon": {
         "16": "icons/bardeen-16.png",
         "32": "icons/bardeen-32.png"
      },
      "default_title": "Bardeen: Automate Browser Apps with AI"
   },
   "background": {
      "service_worker": "background.js"
   },
   "browser_specific_settings": {
      "gecko": {
         "id": "extension@bardeen.ai",
         "strict_min_version": "42.0"
      }
   },
   "commands": {
      "_execute_action": {
         "suggested_key": {
            "default": "Alt+B",
            "mac": "Alt+B"
         }
      }
   },
   "content_scripts": [ {
      "css": [ "website-interactive.css" ],
      "js": [ "website-interactive.js" ],
      "matches": [ "*://*.bardeen.ai/*", "*://bardeen.webflow.io/*" ],
      "run_at": "document_start"
   }, {
      "css": [ "content.css" ],
      "js": [ "content.js" ],
      "matches": [ "*://*/*" ],
      "run_at": "document_start"
   }, {
      "css": [  ],
      "js": [ "web-onboarding.js" ],
      "matches": [ "https://www.bardeen.ai/start*" ],
      "run_at": "document_start"
   }, {
      "all_frames": true,
      "css": [  ],
      "js": [ "page-events.js" ],
      "match_origin_as_fallback": true,
      "matches": [ "*://*/*" ],
      "run_at": "document_start"
   }, {
      "all_frames": true,
      "css": [  ],
      "js": [ "go-back.js" ],
      "matches": [ "https://docs.google.com/spreadsheets/d/1XMwFKr_elU-JXc9M0GZmyMZAQcXZdZ4luFnHi-kXPv8/*", "https://docs.google.com/spreadsheets/d/1AzaKvWw-4Ikm-0G_ql9B6n4PVa4ZS5xXVWERKHmdABk/*" ],
      "run_at": "document_idle"
   }, {
      "all_frames": true,
      "css": [  ],
      "js": [ "fake-scraper.js" ],
      "matches": [ "https://www.bardeen.ai/bardeen-summit" ],
      "run_at": "document_end"
   } ],
   "content_security_policy": {
      "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
   },
   "default_locale": "en",
   "description": "__MSG_appDesc__",
   "host_permissions": [ "\u003Call_urls>", "*://*/*" ],
   "icons": {
      "128": "icons/bardeen-128.png",
      "16": "icons/bardeen-16.png",
      "32": "icons/bardeen-32.png",
      "48": "icons/bardeen-48.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "__MSG_appName__",
   "permissions": [ "activeTab", "alarms", "bookmarks", "contextMenus", "history", "notifications", "scripting", "storage", "tabs", "tts", "unlimitedStorage", "webNavigation", "offscreen" ],
   "short_name": "Bardeen",
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "4.4.0",
   "web_accessible_resources": [ {
      "matches": [ "*://*/*" ],
      "resources": [ "*.js", "*.gif", "*.jpg", "*.png", "*.svg", "*.woff2", "*.webm", "*.css", "*.blob", "startup-status.html", "offscreen-dom.html", "iframe.html" ]
   } ]
}
