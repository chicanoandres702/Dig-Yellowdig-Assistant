{
  "manifest_version": 3,
  "name": "PagePilot | Dig Yellowdig Assistant",
  "version": "2.4.0",
  "description": "An AI-powered academic assistant for extracting, bucketing, and drafting engagement posts.",
  "action": {
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "side_panel": {
    "default_path": "web-assistant.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "src/core/styles/theme.css",
        "src/features/sidebar/sidebar-theme.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "contextMenus",
    "tabs"
  ],
  "commands": {
    "toggle-side-panel": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Toggle PagePilot side panel"
    }
  },
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://*.yellowdig.app/*",
    "https://*.vitalsource.com/*"
  ],
  "web_accessible_resources": [
    {
            "resources": [
        "web-assistant.html",
        "topographic_waves.html",
        "icon.png",
        "pdf.min.mjs",
        "pdf.js.worker.min.mjs",
              "src/features/sidebar/sidebar-panel.service.js",
              "src/features/sidebar/metadata-sniffer.js",
              "src/page-scripts/pagepilot-sw-logger.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}